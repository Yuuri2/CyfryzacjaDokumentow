# Skopiuj do .env. Nie commituj .env.
# AI_PROVIDER=eden używa Eden AI; local używa lokalnego Ollama z tym samym Qwen3.5-9B.
AI_PROVIDER=eden
EDENAI_API_KEY=
EDENAI_MODEL=ovhcloud/Qwen3.5-9B
LOCAL_AI_MODEL=qwen3.5:9b
# Domyślnie port tylko na loopbacku; dla jury w sieci ustaw 0.0.0.0
APP_BIND=127.0.0.1
APP_PORT=8080
MAX_UPLOAD_MB=20
