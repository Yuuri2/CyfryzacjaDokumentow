# Skopiuj do .env i uzupełnij. Nie commituj .env.
# Wymagany sekret JWT (min. 32 znaki losowe), np.: openssl rand -base64 48
EDENAI_API_KEY=
JWT_ISSUER=formforge
JWT_TTL_SECONDS=3600
# Domyślnie port tylko na loopbacku; dla jury w sieci ustaw 0.0.0.0
APP_BIND=127.0.0.1
APP_PORT=8080
MAX_UPLOAD_MB=20
